FROM node:22-bookworm-slim

WORKDIR /app

# 1. Copie uniquement les fichiers de dépendances
COPY package.json package-lock.json ./
COPY packages/message-format/ ./packages/message-format/

# 2. Installation des dépendances de production
RUN npm ci --omit=dev

# 3. Copie du code source et des tests APRÈS l'installation
COPY src/ ./src/
COPY test/ ./test/

EXPOSE 8080

CMD ["node", "src/server.js"]