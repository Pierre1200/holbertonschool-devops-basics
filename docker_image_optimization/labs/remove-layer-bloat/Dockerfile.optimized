# syntax=docker/dockerfile:1
FROM alpine:3.22

RUN --mount=type=bind,source=build-payload.bin,target=/mnt/build-payload.bin,ro \
    cp /mnt/build-payload.bin /tmp/build-payload.bin && \
    sha256sum /tmp/build-payload.bin | cut -d ' ' -f 1 > /artifact.sha256 && \
    rm -f /tmp/build-payload.bin

CMD ["cat", "/artifact.sha256"]